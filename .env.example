# ---------------------------------------------------------------------------
# Application environment (backend / server side)
# Copy to .env for local development. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

NODE_ENV=development

# Port used by `next start` (Render injects PORT automatically).
PORT=3000

# PostgreSQL connection string.
# Local:      postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Render:     copy the Internal Database URL from the Render dashboard
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Maximum PostgreSQL pool connections (Render free tier: keep at or below 10).
PG_POOL_MAX=10

# Secrets used to sign administrator session tokens.
# Generate with: openssl rand -hex 32
JWT_SECRET=
SESSION_SECRET=

# Public origin of the deployed site. Used for canonical URLs, Open Graph and CORS.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Origin allowed to call the API from a browser (production frontend URL).
FRONTEND_URL=http://localhost:3000

# Base URL used by the browser API client.
# Same-origin default is "/api". For a separately hosted backend use:
# NEXT_PUBLIC_API_URL=https://your-church-api.onrender.com/api
NEXT_PUBLIC_API_URL=/api

# ---------------------------------------------------------------------------
# Initial administrator (used by `npm run seed` only)
# Change these before seeding a production database.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@church.local
ADMIN_PASSWORD=ChurchAdmin@2026!
ADMIN_NAME=Church Administrator

# ---------------------------------------------------------------------------
# Optional church profile overrides (safe to expose to the browser)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CHURCH_NAME=Grace Covenant Church
NEXT_PUBLIC_CHURCH_ADDRESS=12 Cornerstone Avenue, Riverside District
NEXT_PUBLIC_CHURCH_PHONE=+1 (555) 014-8820
NEXT_PUBLIC_CHURCH_EMAIL=hello@gracecovenant.org
